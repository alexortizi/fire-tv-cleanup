<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
  Dock/grid order and user hides are also editable on the TV (Menu / hold OK on a tile).
-->
<resources>

    <!-- Starting dock, in this order. After that the dock is edited on the TV (hold OK or press Menu on an app)
         and saved on the device. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.amazon.firetv.youtube</item>
        <item>com.amazon.venezia</item>
        <item>com.amazon.tv.settings.v2</item>
    </string-array>

    <!-- Apps never shown as tiles. User can also hide more from the TV (Menu → Hide from Home). -->
    <string-array name="hidden_apps">
        <item>com.amazon.tv.launcher</item>
        <item>com.amazon.tv.livetv</item>
        <item>com.mediatek.opapp</item>
        <item>com.amazon.smarthomemapviewapp</item>
        <item>com.amazon.spiderpork</item>
        <item>com.amazon.bueller.music</item>
        <item>com.amazon.bueller.photos</item>
        <item>com.amazon.cloud9</item>
        <item>com.amazon.hedwig</item>
        <item>com.amazon.tahoe</item>
        <item>com.amazon.ssm</item>
        <item>com.amazon.ftv.profilepicker</item>
        <item>com.amazon.ftv.screensaver</item>
        <item>com.amazon.tv.csapp</item>
        <item>com.amazon.tv.support</item>
        <item>com.amazon.tv.releasenotes</item>
        <item>com.amazon.tv.notificationcenter</item>
        <item>com.amazon.ceviche</item>
        <item>com.amazon.imdb.tv.android.app</item>
    </string-array>

    <string name="live_tv_package" translatable="false">com.amazon.tv.livetv</string>

    <!-- Tiles per row in the grid, and the most apps the dock can hold. -->
    <integer name="columns">6</integer>
</resources>
