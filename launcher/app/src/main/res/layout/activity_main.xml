<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E10"
    android:clipChildren="false">

    <!-- Bing picture of the day (cached). -->
    <ImageView
        android:id="@+id/bgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Readable scrim over the photo. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:importantForAccessibility="no" />

    <!-- Kept for code compatibility; hidden for a cleaner Bing-first look. -->
    <View
        android:id="@+id/colorBlob"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />



    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Focused app name — top-left under the greeting/clock, not over the dock. -->
    <TextView
        android:id="@+id/focusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="50dp"
        android:alpha="0"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans"
        android:fontVariationSettings="'wght' 600"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:maxWidth="720dp"
        android:maxLines="1"
        android:shadowColor="#88000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp" />

    <!-- Kept for code compatibility; hidden in the minimal layout. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:clipChildren="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/open_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textColor="#99E6E1E5"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:fontVariationSettings="'wght' 400"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:textColor="#FFFFFFFF"
                        android:textSize="56sp" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/open_sans"
                        android:fontVariationSettings="'wght' 500"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="#B3E6E1E5"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginBottom="12dp"
                        android:background="#33E6E1E5" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/open_sans"
                        android:fontVariationSettings="'wght' 400"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:letterSpacing="0.04"
                        android:textColor="#B3E6E1E5"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Material button group strip. -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="4dp"
                android:background="@drawable/top_bar_strip"
                android:orientation="horizontal"
                android:padding="5dp">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWallpaper"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/refresh_wallpaper"
                    android:drawableStart="@drawable/ic_wallpaper_refresh"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid"
                    android:text="@string/wifi" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:overScrollMode="never"
                android:paddingStart="40dp"
                android:paddingTop="10dp"
                android:paddingEnd="40dp"
                android:paddingBottom="36dp"
                android:scrollbars="none" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/dockDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:alpha="0"
        android:background="@drawable/dock_dot" />

    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
